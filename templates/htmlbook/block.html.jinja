{#-

NOTE: This file includes all block macros so that they can call each other
recursively (e.g., a list calling render_block). This also keeps the template
loading code simple.

-#}
{%- from "inline.html" import render_inline -%}

{%- macro render_block(block) -%}

{%- if block.name == "section"-%}
    {{ render_section(block) }}
    
{#- lists -#}
{%- elif block.name == "list" -%}
    {{ render_list(block)}}

{#- list items -#}
{%- elif block.name == "listItem" -%}
    {{ render_list_item(block) }}
{#- description lists -#}
{%- elif block.name == "dlist" -%}
    {{ render_dlist(block) }}

{#- description list items -#}
{%- elif block.name == "dlistItem" -%}
    {{ render_dlist_item(block) }}

{#- breaks -#}
{%- elif block.name == "break" -%}
    {% if block.variant == "page" %}
    <div style="page-break-after: always;"></div>
    {% elif block.variant == "thematic" %}
    <hr />
    {%- endif -%}

{#- block macros -#}
{%- elif block.name == "image" -%}
    {{ render_image(block) }}

{#- leaf blocks -#}
{%- elif block.name in ["paragraph", "listing", "verse", "pass", "literal"] %}
    {{ render_leafblock(block) }}

{#- parent blocks -#}
{%- elif block.name in ["admonition", "example", "open", "quote", "sidebar"] -%}
    {{ render_parent_block(block) }}

{#- tables -#}
{%- elif block.name == "table" -%}
    {{ render_table(block) }}

{%-endif-%}
{%- endmacro -%}


{# ======== shared macros ======== #}

{#- ` id="..."` for a block that was given an id (e.g., with `[[id]]`) -#}
{%- macro id_attr(block) -%}
    {%- if block.metadata and block.metadata.attributes and block.metadata.attributes.id %} id="{{ block.metadata.attributes.id | escape_attr }}"{%- endif -%}
{%- endmacro -%}

{% macro render_title_for_block(block, level=none) %}
        {%- if level -%}
            {%- set title_heading_level = level -%}
        {%- elif block.name in ["example", "sidebar"]-%}
            {%- set title_heading_level = 5 -%}
        {%- else -%}
            {%- set title_heading_level = 1 -%}
        {%- endif %}
    <h{{title_heading_level}}>{%- for inline in block.title -%}{{- render_inline(inline) -}}
    {%- endfor -%}</h{{title_heading_level}}>
{%- endmacro -%}



{# ======== block-specific macros ======== #}

{%- macro render_section(block) -%}
{#- the section's id is the one it was given, or the one the parser generated -#}
{%- set id = section_id(block) -%}
<section data-type="sect{{block.level}}"
        {%- if block.metadata and block.metadata.roles %} class="{{ block.metadata.roles | join(" ") | escape_attr }}" {%- endif -%}
        {%- if id %} id="{{ id | escape_attr }}" {%- endif -%}>
    {% if block.title %}
        {{ render_title_for_block(block) }}
    {% endif -%}
    {% for block in block.blocks %}
        {{ render_block(block) }}
    {%- endfor -%}
</section>
{%- endmacro -%}

{#- List titles are kept in the ASG, but intentionally not rendered by this backend (yet) -#}
{%- macro warn_unrendered_list_title(block) -%}
    {%- if block.title -%}
        {{- warn("Line " ~ block.location[0].line ~ ": Titles on lists are not rendered by the HTMLBook backend yet") -}}
    {%- endif -%}
{%- endmacro -%}

{%- macro render_list(block) -%}
    {{- warn_unrendered_list_title(block) -}}
    {%- set tag = "ul" if block.variant == "unordered" else "ol" -%}
    <{{tag}}
    {%- if block.metadata and block.metadata.roles %} class="{{ block.metadata.roles | join(" ") | escape_attr }}"{%- endif -%}
    {{- id_attr(block) -}}>
    {%- for item in block.items -%}
        {{ render_block(item) }}
    {%- endfor -%}
    </{{tag}}>
{%- endmacro -%}

{%- macro render_principal(block) -%}
    {%- if block.principal -%}
        <p>{%- for inline in block.principal -%}
            {{- render_inline(inline) -}}
        {%- endfor -%}</p>
    {%- endif -%}
{%- endmacro -%}

{%- macro render_list_item(block) -%}
    <li>
    {{- render_principal(block) -}}
    {%- for child in block.blocks -%}
        {{- render_block(child) -}}
    {%- endfor -%}
    </li>
{%- endmacro -%}

{%- macro render_dlist(block) -%}
    {{- warn_unrendered_list_title(block) -}}
    <dl{{ id_attr(block) }}>
    {%- for item in block.items -%}
        {{ render_block(item) }}
    {%- endfor -%}
    </dl>
{%- endmacro -%}

{%- macro render_dlist_item(block) -%}
    {%- for term in block.terms -%}
    <dt>{%- for inline in term -%}
        {{- render_inline(inline) -}}
    {%- endfor -%}</dt>
    {%- endfor -%}
    {#- a term with no description (one of several terms) has no <dd> -#}
    {%- if block.principal or block.blocks -%}
    <dd>
    {{- render_principal(block) -}}
    {%- for child in block.blocks -%}
        {{- render_block(child) -}}
    {%- endfor -%}
    </dd>
    {%- endif -%}
{%- endmacro -%}

{#- Admonitions, examples, open blocks, quotes and sidebars all share the same shape:
    an enclosing tag, an optional title, child blocks and (for quotes) an attribution. -#}
{%- macro render_parent_block(block) -%}
    {%- set attrs = block.metadata.attributes if block.metadata and block.metadata.attributes else {} -%}
    {%- set data_type = none -%}
    {%- if block.name == "quote" -%}
        {%- set tag = "blockquote" -%}
    {%- elif block.name == "sidebar" -%}
        {%- set tag = "aside" -%}
        {%- set data_type = "sidebar" -%}
    {%- elif block.name == "admonition" -%}
        {%- set tag = "div" -%}
        {%- set data_type = block.variant -%}
    {%- else -%}
        {%- set tag = "div" -%}
    {%- endif -%}
    <{{tag}}
    {%- if block.metadata and block.metadata.roles %} class="{{ block.metadata.roles | join(" ") | escape_attr }}"{%- endif -%}
    {%- if attrs.id %} id="{{ attrs.id | escape_attr }}"{%- endif -%}
    {%- if data_type %} data-type="{{ data_type }}"{%- endif -%}>
    {%- if block.title -%}
        {{ render_title_for_block(block) }}
    {%- endif -%}
    {%- for child in block.blocks -%}
        {#- the block syntax for admonitions wraps its content in an example block (from the ==== delimiter); unwrap it -#}
        {%- if block.name == "admonition" and child.name == "example" -%}
            {#- ...so the title lives on the wrapper, but is still the admonition's title -#}
            {%- if child.title -%}
                {{ render_title_for_block(child, 1) }}
            {%- endif -%}
            {%- for grandchild in child.blocks -%}
                {{ render_block(grandchild) }}
            {%- endfor -%}
        {%- else -%}
            {{ render_block(child) }}
        {%- endif -%}
    {%- endfor -%}
    {%- if block.name == "quote" and attrs.attribution -%}
        <p data-type="attribution">{{ attrs.attribution | escape_text }}
        {%- if attrs.citation -%}, {{ attrs.citation | escape_text }}{%- endif -%}</p>
    {%- endif -%}
    </{{tag}}>
{%- endmacro -%}

{%- macro render_image(block) -%}
    {%- set attrs = block.metadata.attributes if block.metadata and block.metadata.attributes else {} -%}
    <figure
    {%- if attrs.id %} id="{{ attrs.id | escape_attr }}"{%- endif -%}>
    {%- if block.title -%}
        {{ render_title_for_block(block) }}
    {%- endif -%}
    <img src="{{ block.target | escape_attr }}"
    {%- if attrs.positional_1 %} alt="{{ attrs.positional_1 | escape_attr }}"{%- endif -%}/>
    {%- if block.caption -%}
        <figcaption>{%- for inline in block.caption -%}
            {{- render_inline(inline) -}}
        {%- endfor -%}</figcaption>
    {%- endif -%}
    </figure>
{%- endmacro -%}

{%- macro render_leafblock(block) -%}
{#- Leaf blocks, which never have child blocks, include:
    Listing,
    Literal,
    Paragraph,
    Pass,
    Stem, // TK not handling now
    Verse,
    Comment, // Gets thrown away, but convenient

    Only listing, literal and verse blocks render titles; per HTMLBook, a titled
    block of this kind is wrapped in an "example" with an h5 title.
-#}
    {%- set tag = none -%}
    {%- set data_type = none -%}
    {%- set code_language = none -%}
    {%- set titled = false -%}
    {%- if block.name == "paragraph" -%}
        {%- set tag = "p" -%}
    {%- elif block.name == "listing" -%}
        {%- set tag = "pre" -%}
        {%- set data_type = "programlisting" -%}
        {%- set titled = true -%}
        {%- if block.metadata and block.metadata.attributes and block.metadata.attributes.language -%}
            {%- set code_language = block.metadata.attributes.language -%}
        {%- endif -%}
    {%- elif block.name == "verse" -%}
        {%- set tag = "pre" -%}
        {%- set data_type = "verse" -%}
        {%- set titled = true -%}
    {%- elif block.name == "literal" -%}
        {%- set tag = "pre" -%}
        {%- set titled = true -%}
    {%- endif -%}
{%- if titled and block.title -%}
<div data-type="example">{{ render_title_for_block(block, 5) }}
{%- endif -%}
{%- if tag -%}<{{tag}}
{%- if block.metadata and block.metadata.roles %} class="{{ block.metadata.roles | join(" ") | escape_attr }}" {%- endif -%}
{{- id_attr(block) -}}
{%- if data_type %} data-type="{{ data_type }}"{%- endif -%}
{%- if code_language %} data-code-language="{{ code_language | escape_attr }}" {%- endif -%}>{%- endif -%}
    {#- The ASG keeps the newlines next to a delimited block's delimiters, and whitespace matters
        inside <pre>, so those are dropped there -#}
    {%- set content -%}
    {%- for inline in block.inlines -%}
    {#- passthrough content is output exactly as written -#}
    {%- if block.name == "pass" -%}{{- inline.value -}}{%- else -%}{{- render_inline(inline) -}}{%- endif -%}
    {%- endfor -%}
    {%- endset -%}
    {%- if tag == "pre" -%}{{- content | trim("\n") -}}{%- else -%}{{- content -}}{%- endif -%}
{%- if tag -%}</{{tag}}>{%- endif -%}
{%- if titled and block.title -%}</div>{%- endif -%}
{%- endmacro -%}


{%- macro render_table(block) -%}
{#- Collect Cells into rows; should be save to assume that all tables have a cols attr -#}
{% set cols = block.metadata.attributes.cols | int %}
{%- set body_start = 0 -%}
{%- if "header" in block.metadata.options -%}
{%- set header = true -%}
{%- set body_start = cols -%}
{%- endif -%}
    <table{{ id_attr(block) }}>
    {%- if block.title -%}
    <caption>{%- for inline in block.title -%}
        {{- render_inline(inline) -}}
    {%- endfor -%}</caption>
    {%- endif -%}
    {% if header %}
    <thead>
        <tr>
        {% for idx in range(0, body_start) -%}
            {%- set cell = block.blocks[idx] -%}
                {{ process_table_cell(cell, tag="th") }}
    {% endfor %}</tr>
    </thead>
    <tbody>
        <tr>
        {%- else -%}
        <tr>
        {%- endif %}
        {% set num_cells = block.blocks | length -%}
        {% for idx in range(body_start, num_cells) -%}
            {%- set cell = block.blocks[idx] -%}
                {{ process_table_cell(cell=cell, tag="td") -}}
        {% if idx > 0 and (idx + 1) % cols == 0 and idx+1 != num_cells %}
        </tr>
        <tr>{%- endif %}
        {% endfor %}</tr>
    {%- if header %}
    </tbody>{%- endif %}
    </table>
{%- endmacro -%}

{%- macro process_table_cell(cell, tag) -%}
    <{{tag}}>
    {%- if cell.inlines -%}
    {%- for inline in cell.inlines -%}
    {{- render_inline(inline) -}}
    {%- endfor -%}
    {%- endif -%}
    </{{tag}}>
{%- endmacro -%}
