{%- from "inline.html" import render_inline -%}
{%- from "block.html" import render_block -%}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>
{%- if graph.header -%}
{%- for inline in graph.header.title -%}
{{- render_inline(inline) -}}
{%- endfor -%}
{%- endif -%}
</title>
</head>
<body class="article">
{%- if graph.header %}
<div id="header">
<h1>
{%- for inline in graph.header.title -%}
{{- render_inline(inline) -}}
{%- endfor -%}
</h1>
</div>
{%- endif %}
<div id="content">
{%- for block in graph.blocks %}
{{ render_block(block) }}
{%- endfor %}
</div>
<div id="footer">
<div id="footer-text">
Last updated {{ current_time }}
</div>
</div>
</body>
</html>
